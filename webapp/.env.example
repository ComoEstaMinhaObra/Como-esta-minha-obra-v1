# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=xxx

# Preços (centavos) — fonte única de precificação (BRIEFING §3)
NEXT_PUBLIC_PRECO_OBRA_CENTAVOS=12990
NEXT_PUBLIC_PRECO_EMAIL_EXTRA_CENTAVOS=2990

# Trial (BRIEFING §3)
NEXT_PUBLIC_TRIAL_DIAS=14
NEXT_PUBLIC_TRIAL_LIMITE_RELATORIOS=1

# Turnstile (opcional no local; obrigatório em produção — Codex configura o secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Login social (só para testar local com [auth.external.*] habilitado; em produção
# fica no painel do Supabase → Auth → Providers)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=

# E-mail
RESEND_API_KEY=re_xxx
EMAIL_FROM="Como Está Minha Obra <relatorios@comoestaminhaobra.com.br>"

# Cron
CRON_SECRET=xxx

# Mercado Pago (cobrança por obra). Credenciais de TESTE em .env.local / Vercel;
# nunca versionar valores reais. O token é só de servidor; a public key é pública por desenho.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
# Chave secreta do webhook: painel Mercado Pago → Suas integrações → Webhooks
MERCADOPAGO_WEBHOOK_SECRET=xxx
